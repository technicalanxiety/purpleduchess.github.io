# Image Protection .htaccess
# Additional server-side protection for images

# Prevent direct access to image files
<FilesMatch "\.(jpg|jpeg|png|gif|bmp|webp)$">
    # Add copyright headers
    Header set X-Copyright "© The Purple Duchess - All Rights Reserved"
    Header set X-Robots-Tag "noindex, nofollow, nosnippet, noarchive, noimageindex"
    
    # Prevent hotlinking
    RewriteEngine On
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?purpleduchess\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost [NC]
    RewriteRule \.(jpg|jpeg|png|gif|bmp|webp)$ - [F,L]
    
    # Add cache control for images
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Prevent direct downloads
    <IfModule mod_headers.c>
        Header set Content-Disposition "inline"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>

# Disable directory browsing
Options -Indexes

# Prevent access to sensitive files
<FilesMatch "\.(rb|yml|yaml|log|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compress images for faster loading while maintaining quality
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>